                                      <property name="bytes"><![CDATA[
  <?xml version="1.0" encoding="UTF-8"?>
  <interface>
    <menu id="cmenu">
      <section>
        <item>
          <attribute name="label" translatable="yes">Copy Hexcode to Clipboard</attribute>
          <attribute name="action">win.action_exc_txt</attribute>
